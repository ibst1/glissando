<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK projection is needed for the WinRT Bluetooth LE APIs;
         22621 gives BluetoothLEPreferredConnectionParameters should we ever want it. -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Glissando</RootNamespace>
    <AssemblyName>Glissando</AssemblyName>
    <Version>0.3.0</Version>
    <!-- Hooks and cursor maths work in physical pixels on mixed-DPI setups. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Roughly halves the self-contained single-file exe; costs a little at start-up. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- build.ps1 sets InformationalVersion to 0.3.N+shorthash itself; stop the SDK appending the full SHA. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Glissando.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(Pkgbblanchon_PDFium_Win32)\runtimes\win-x64\native\pdfium.dll" LogicalName="pdfium.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- build.ps1 passes -p:BuildTime; Program.Version shows it next to the version. -->
    <AssemblyMetadata Include="BuildTime" Value="$(BuildTime)" Condition="'$(BuildTime)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <!-- PDFium (Chrome's PDF engine) prints filled-in forms right, where Windows.Data.Pdf picks the wrong font.
         Only its pdfium.dll is used, embedded in the exe (RS gets the exe alone) and unpacked on first print. -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="158.0.8125" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
